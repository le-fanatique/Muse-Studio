# ============================================================
# Secrets & credentials (never commit)
# ============================================================

*.pem
*.key
*.p12
*token*.json
*credentials*.json
service-account*.json

.env
.env.*
!.env.example

muse_backend/.env
muse_backend/.env.*
!muse_backend/.env.example

muse-studio/.env.local
muse-studio/.env*.local
!muse-studio/.env.example


# ============================================================
# Python / backend
# ============================================================

__pycache__/
*.py[cod]
*$py.class

venv/
.venv/
env/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

muse_backend/__pycache__/
